#--------------------------------------------------------------------
# SIP Gatutkaca (CodeIgniter 4) — contoh berkas lingkungan
#
# Salin menjadi `.env` di server dan isi nilainya. `.env` TIDAK boleh
# di-commit (sudah ada di .gitignore) dan tidak boleh bisa dibuka dari web
# (diblokir oleh .htaccess).
#
# Di server yang sebelumnya CodeIgniter 3, cukup jalankan:
#   php spark migrasi:konfigurasi
# untuk membuat .env dari application/config/database.php lama.
#--------------------------------------------------------------------

# production = galat disembunyikan dari pengunjung (dicatat di writable/logs)
# development = galat lengkap + pelacakan (hanya untuk komputer pengembang)
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = "localhost"
database.default.database = "nama_database"
database.default.username = "pengguna_database"
database.default.password = "kata_sandi_database"
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# OPSIONAL
#--------------------------------------------------------------------
# Zona waktu aplikasi. Bila dikosongkan memakai zona waktu bawaan PHP server
# (sama seperti versi CodeIgniter 3 sebelumnya).
# app.appTimezone = "Asia/Jakarta"

# Base URL terdeteksi otomatis dari alamat yang diakses; isi hanya bila perlu dipaksa.
# app.baseURL = "https://sipgatutkaca.sigaru.my.id/"
