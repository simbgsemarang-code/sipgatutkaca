# Pastikan permintaan ke folder (termasuk root "/") otomatis diarahkan
# ke index.php, dan direktori TIDAK PERNAH ditampilkan sebagai daftar
# file mentah -- dinyatakan eksplisit, tidak bergantung pada default
# server yang bisa berbeda-beda antar hosting/konfigurasi LiteSpeed.
DirectoryIndex index.php
Options -Indexes

# Tanpa <IfModule mod_rewrite.c> -- di LiteSpeed Web Server (banyak
# dipakai cPanel modern), modul rewrite-nya kadang tidak terdeteksi
# dengan nama persis "mod_rewrite.c", sehingga seluruh blok di dalam
# IfModule ikut dilewati dan URL selain root (mis. /konsultasi/pbg)
# 404 duluan sebelum sempat masuk ke index.php. LiteSpeed maupun
# Apache sama-sama memahami directive di bawah ini langsung.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# deploy-hook.php sendiri TETAP bisa diakses (perlu, supaya GitHub bisa
# memanggilnya) - yang diblokir cuma file pendukungnya: log, lock, dan
# config (config.php aman diakses langsung karena isinya cuma
# "return array(...)" tanpa echo, tapi tetap ditutup untuk jaga-jaga).
<FilesMatch "^deploy-hook\.(log|lock|config\.php)$">
	Require all denied
</FilesMatch>

# Batas upload dinaikkan supaya berkas sampai 100MB (lihat max_size di
# controller terkait) tidak ditolak PHP sebelum sempat diproses.
# .user.ini di root TIDAK berpengaruh di hosting ini (SAPI: litespeed
# via LSAPI, terbukti dari admin/php-info-check masih menunjukkan nilai
# default PHP polos) - LiteSpeed justru menghormati php_value lewat
# .htaccess seperti ini, jadi dipakai di sini sebagai jalur yang benar2
# aktif untuk server ini.
php_value upload_max_filesize 100M
php_value post_max_size 110M
php_value memory_limit 256M
php_value max_execution_time 300
php_value max_input_time 300
