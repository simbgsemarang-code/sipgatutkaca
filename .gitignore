# Claude Code local session/tooling files
.claude/

# CodeIgniter logs (keep the folder via its index.html placeholder)
application/logs/*.php
application/logs/*.log

# Local database credentials
application/config/database.php

# Berkas unggahan pemohon (dokumen PBG/SLF) - data pengguna, bukan
# source code. Folder tetap ditrack lewat index.html placeholder-nya.
application/uploads/pengajuan_pbg/*
!application/uploads/pengajuan_pbg/index.html
application/uploads/pengajuan_slf/*
!application/uploads/pengajuan_slf/index.html

# Kecuali folder dummy_lengkap/ - berkas CONTOH/dummy (bukan data
# pengguna sungguhan) untuk 1 data uji coba Pengajuan PBG lengkap,
# lihat database/pengajuan_pbg_dummy_lengkap.sql. Folder unggahan
# pengguna sungguhan (nama folder = ID numerik permohonan) tetap
# diabaikan seperti biasa.
!application/uploads/pengajuan_pbg/dummy_lengkap/

# Konfigurasi rahasia webhook auto-deploy (berisi secret asli - lihat
# deploy-hook.config.php.example untuk templatenya) + file runtime
# yang dibuat otomatis oleh deploy-hook.php
deploy-hook.config.php
deploy-hook.log
deploy-hook.lock

# OS/editor cruft
Thumbs.db
.DS_Store
